{
  "name": "svusd-arb-bot",
  "version": "0.1.0",
  "private": true,
  "description": "sVUSD arbitrage bot: buy sVUSD below fair value on Curve, redeem via the StakingVault 7-day cooldown, capture the spread. Contract-custody; stateless bot, on-chain position state.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "rehearse": "bash scripts/rehearse.sh"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "viem": "^2.56.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
