# ─────────────────────────────────────────────────────────────────────────
# sVUSD arbitrage bot environment
# The dry-run monitor only needs ETHEREUM_RPC_URL. Everything else has safe
# defaults in src/constants.ts / src/config.ts and is optional until live mode.
# The strategy is VUSD-native: VUSD in, VUSD out, no Gateway, no stable leg.
# ─────────────────────────────────────────────────────────────────────────

# Ethereum mainnet JSON-RPC (Alchemy / Infura / QuickNode / publicnode)
ETHEREUM_RPC_URL=

# ── Profit gate (all optional; VUSD human units) ─────────────────────────────
# Fallback profit floor (bps of VUSD spent), used ONLY when ARBITRAGE_ADDRESS is unset.
# With a contract wired the bot reads its live minProfitBps instead. 0 = break-even.
MIN_PROFIT_BPS=0
# Off-chain gas-cost assumption for a full open+claim round trip, in VUSD.
ESTIMATED_GAS_COST_VUSD=15
# Prudence buffer (bps of position size) on top of gas, margin for quote drift
# and the 7-day VUSD hold. Not a depeg hedge: the VUSD-native spread is fixed at
# open and VUSD depeg does not erode it.
BUFFER_BPS=30
# Skip when gas price exceeds this (gwei).
MAX_GAS_PRICE_GWEI=40

# ── Sizing (dry-run simulates buys at these VUSD notionals) ──────────────────
# Comma-separated test sizes in VUSD. The monitor quotes each through the real
# Curve pools so you see price impact on the thin (~$43k) sVUSD pool.
PROBE_SIZES_VUSD=1000,5000,10000,25000

# Poll interval (ms).
POLL_INTERVAL_MS=15000
# Max matured requests settled per tick; keeps the batch gas-bounded, successive ticks drain the rest.
SETTLE_BATCH_CAP=20

# ── Health server (GET /status) ──────────────────────────────────────────────
# Port for /status. Render injects PORT automatically; set only to override locally.
PORT=10000
# /status returns 503 (Render restarts) if no tick within this window. Default
# max(5x poll, 120s); if set, must exceed your slowest tick (a live tx mining).
# HEALTH_STALE_MS=120000

# ── Live mode (leave unset for dry-run) ──────────────────────────────────────
# Keeper key that TRIGGERS the arbitrage contract (never custodies funds). Hex,
# no 0x prefix. Leave EMPTY for dry-run; startup banner shows Mode: DRY-RUN.
PRIVATE_KEY=
# Deployed SVusdArbitrage contract that holds the VUSD reserves.
# Address is in the deploy broadcast record (broadcast/Deploy.s.sol/1/run-latest.json).
ARBITRAGE_ADDRESS=

# Broadcast gate. "dry-run" (default) simulates every send and never broadcasts;
# "live" broadcasts. "live" is only accepted with PRIVATE_KEY + ARBITRAGE_ADDRESS.
TX_MODE=dry-run
# Kill switch. "true" makes the executor simulate but refuse to broadcast.
PAUSED=false
# Hard ceiling on VUSD spent per open, enforced before any send.
MAX_TX_SPEND_VUSD=10000
# Slippage tolerance on the entry quote that sets the swap's minAmountOut, in bps.
ENTRY_SLIPPAGE_BPS=50

# Quote DEX aggregators alongside native Curve and take the best fill. Off by default:
# sVUSD trades only on Curve today, so aggregators mostly return no route. Turn on when
# sVUSD lists on more venues. LiFi works keyless; a 1inch key is optional.
ENABLE_AGGREGATORS=false
ONEINCH_API_KEY=
LIFI_API_KEY=
