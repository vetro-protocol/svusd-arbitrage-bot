# ─────────────────────────────────────────────────────────────────────────
# sVUSD arbitrage bot environment
# The dry-run monitor only needs ETHEREUM_RPC_URL. Everything else has safe
# defaults in src/constants.ts / src/config.ts and is optional until live mode.
# The strategy is VUSD-native: VUSD in, VUSD out, no Gateway, no stable leg.
# ─────────────────────────────────────────────────────────────────────────

# Ethereum mainnet JSON-RPC (Alchemy / Infura / QuickNode / publicnode)
ETHEREUM_RPC_URL=

# ── Profit gate (all optional; VUSD human units) ─────────────────────────────
# Minimum NET profit (after gas + buffer) to flag/execute an opportunity, in VUSD.
MIN_PROFIT_VUSD=25
# On-chain floor mirror: bps of VUSD spent, matching the contract's minProfitBps.
# The monitor won't flag an open the contract would reject. 0 = off (break-even).
MIN_PROFIT_BPS=0
# Off-chain gas-cost assumption for a full open+claim round trip, in VUSD.
ESTIMATED_GAS_COST_VUSD=15
# Prudence buffer (bps of position size) on top of gas, margin for quote drift
# and the 7-day VUSD hold. Not a depeg hedge: the VUSD-native spread is fixed at
# open and VUSD depeg does not erode it.
BUFFER_BPS=30
# Skip when gas price exceeds this (gwei).
MAX_GAS_PRICE_GWEI=40

# ── Sizing (dry-run simulates buys at these VUSD notionals) ──────────────────
# Comma-separated test sizes in VUSD. The monitor quotes each through the real
# Curve pools so you see price impact on the thin (~$43k) sVUSD pool.
PROBE_SIZES_VUSD=1000,5000,10000,25000

# Poll interval (ms).
POLL_INTERVAL_MS=15000

# ── Live mode (leave unset for dry-run) ──────────────────────────────────────
# Keeper key that TRIGGERS the arbitrage contract (never custodies funds). Hex,
# no 0x prefix. Leave EMPTY for dry-run; startup banner shows Mode: DRY-RUN.
PRIVATE_KEY=
# Deployed SVusdArbitrage contract that holds the VUSD reserves.
ARBITRAGE_ADDRESS=
